# Puerto HTTP del backend
PORT=3000
# Origen permitido del frontend (CORS)
WEB_ORIGIN=http://localhost:5173
# Fichero SQLite (relativo a apps/api)
DB_PATH=data/saasomatic.sqlite
# Sincronización del IVA de la UE (VATcomply). Intervalo por defecto: 24 h
VAT_SYNC_URL=https://api.vatcomply.com/vat_rates
VAT_SYNC_INTERVAL_MS=86400000
VAT_SYNC_TIMEOUT_MS=10000
